DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=3002

# --- Foto-opslag buiten de database (optioneel) ---
# Staan deze niet ingevuld, dan blijven foto's als bytea in Postgres staan en
# verandert er niets. Zodra ze er wel staan gaan nieuwe foto's naar de bucket;
# bestaande verhuizen met de knop in het beheerscherm (Beheer > Opslag).
#
# Werkt met elke S3-compatibele dienst: Cloudflare R2, AWS S3, Backblaze B2,
# MinIO. De bucket hoort NIET publiek te zijn — de app tekent per weergave een
# tijdelijke URL. Alleen als er een CDN voor staat dat zelf afschermt kan
# S3_PUBLIC_BASE gebruikt worden, en dan wordt er niet meer getekend.
#
# Let op: de Content-Security-Policy staat https-afbeeldingen van elke host toe,
# dus een https-endpoint werkt zonder aanpassing. Een MinIO op http:// tijdens
# ontwikkelen wordt door de browser geweigerd.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=reisplanner-fotos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_URL_TTL_SECONDS=21600
# S3_PUBLIC_BASE=https://fotos.jouwdomein.nl
